# ─── Database ───
# Use postgresql+psycopg:// or postgresql+asyncpg:// for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://linknest:linknest@localhost:5432/linknest

# ─── Redis (optional — falls back to in-memory) ───
REDIS_URL=redis://localhost:6379/0

# ─── CORS / Frontend ───
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional allowed CORS origins (e.g. staging URL)
EXTRA_CORS_ORIGINS=

# ─── Auth (Neon Auth) ───
# Get these from your Neon Auth dashboard
NEON_AUTH_URL=
NEON_AUTH_AUDIENCE=

# Set to "production" in production. Affects CORS, docs exposure, dev bypass.
ENVIRONMENT=development

# DO NOT enable in production. Bypasses JWKS validation and trusts X-User-Email header.
DEV_AUTH_BYPASS=false

# Used to sign fallback tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# ─── Rate limiting ───
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─── GeoIP (MaxMind GeoLite2-City.mmdb) ───
GEOLITE_DB_PATH=./GeoLite2-City.mmdb

# ─── Cloudflare R2 (S3-compatible storage) ───
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=linknest-assets
R2_PUBLIC_URL=

# ─── Stripe ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Set to true in development to skip real Stripe calls and instant-activate plans
STRIPE_DUMMY_MODE=false

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=LinkNest <noreply@linknest.app>

# ─── App ───
# Base URL for short links (used in emails and QR attribution)
SHORT_LINK_BASE_URL=http://localhost:3000
